This Ques can be solved using various approaches
1. Brute Force (Checking all the Sub Arrays using 2 loops)
2. Binary Search (On the range of Sizes)
3. Sliding Window (Using 2 Pointer)

1:
class Solution {
    public int minSubArrayLen(int target, int[] nums) {
        int n = nums.length;

        int ans = n+1;

        for(int i = 0; i<n; i++){
            int add = 0;
            for(int j = i; j<n; j++){
                add += nums[j];

                if(add >= target && j-i+1 < ans){
                    ans = j-i+1;
                }
            }
        }

        return ans == n+1 ? 0 : ans;
    }
}

T.C. -> O(n^2)
S.C. -> O(1)

2:
class Solution {
    boolean check(int[] nums , int target , int size){
        int i = 0 , j = 0;
        int sum = 0;

        while(j < nums.length){
            sum += nums[j];

            if(j-i+1 == size){
                if(sum >= target) return true;

                sum -= nums[i];
                i++;
            }
            j++;
        }

        return false;
    }
    public int minSubArrayLen(int target, int[] nums) {
        int n = nums.length;
        int strt = 1;
        int end = n+1;
        int ans = n+1;

        while(strt <= end){
            int mid = strt + (end - strt)/2;

            if(check(nums , target , mid)){
                ans = mid;
                end = mid-1;
            }
            else{
                strt = mid+1;
            }

        }

        return ans == n+1 ? 0 : ans;
    }
}

T.C. -> O(n.logn)
S.C. -> O(1)

3:
class Solution {
    public int minSubArrayLen(int target, int[] nums) {
        int n = nums.length;

        int sum = 0;
        int minL = n+1;

        int i = 0, j = 0;

        while(j < n){
            sum += nums[j];

            //jitna chota ho sake kar do.
            while(sum >= target){
                minL = Math.min(minL , j-i+1);

                sum -= nums[i];
                i++;
            }

            j++;
        }

        return minL == n+1 ? 0 : minL;
    }
}

T.C. -> O(n)
S.C. -> O(1)
