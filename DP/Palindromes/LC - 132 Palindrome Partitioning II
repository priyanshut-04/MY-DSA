class Solution {
    public int minCut(String s) {
        int n = s.length();

        boolean[][] t = new boolean[n][n];

        for(int L = 1; L <= n; L++){
            for(int i = 0; i+L-1<n; i++){
                int j = i+L-1;

                if(L == 1) {
                    t[i][j] = true;
                }
                else if(L == 2 && s.charAt(i) == s.charAt(j)){
                    t[i][j] = true;
                } 
                else if(s.charAt(i) == s.charAt(j) && t[i+1][j-1]){
                    t[i][j] = true;
                }
            }
        }

        int[] dp = new int[n]; // min cuts required to split this string in palindromes
        Arrays.fill(dp , Integer.MAX_VALUE);
        for(int i = 0; i<n; i++){
            if(t[0][i] == true){
                dp[i] = 0;
            }
            else{
                //check if k+1 is palindrome or not 
                //we are only apply cut if we found palindrome
                for(int k = 0; k<i; k++){
                    if(t[k+1][i] && 1+dp[k] < dp[i]){
                        dp[i] = 1+dp[k];
                    }
                }
            }
        }

        return dp[n-1];
    }
}

T.C. -> O(n^2)
S.C. -> O(n^2) + O(n)
