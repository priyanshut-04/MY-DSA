class Solution {
    int[][] t;
    private boolean palindrome(int i , int j , String s){
        while(i < j){
            if(s.charAt(i) != s.charAt(j)) return false;
            i++;
            j--;
        }

        return true;
    }
    private int solve(int i , int j , String s){
        if(i >= j) return 0;

        if(t[i][j] != -1) return t[i][j];

        if(palindrome(i , j , s)) return 0; //O(n)

        int res = Integer.MAX_VALUE;
        for(int k = i; k<j; k++){ //O(n)
            int temp = 1 + solve(i , k , s) + solve(k+1 , j , s);

            res = Math.min(temp , res);
        }

        return t[i][j] = res;
    }
    public int minCut(String s) {
        int n = s.length();
        t = new int[n][n]; //O(n^2 * (2n)) = O(n^3)

        for(int i = 0; i<n; i++){
            Arrays.fill(t[i] , -1);
        }
        return solve(0 , n-1 , s);
    }
}

T.C. -> O(n^3) or O(n^2 * (n+n))
S.C. -> O(n^2) memoization , O(n) Recursion Stack

