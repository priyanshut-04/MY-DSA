class Solution {
    public int longestPalindromeSubseq(String s) {
        int n = s.length();

        String rev = "";
        for(int i = n-1; i>=0; i--){
            rev += s.charAt(i);
        }
        
        int[][] dp = new int[n+1][n+1];

        //dp[i][j] = LCS of string1 and string2 of length i and j respectively

        for(int i = 0; i<=n; i++){
            for(int j = 0; j<=n; j++){
                if(i == 0 || j == 0){
                    dp[i][j] = 0;
                }
                //i and j are length and we need access.
                else if(s.charAt(i-1) == rev.charAt(j-1)){
                    dp[i][j] = 1 + dp[i-1][j-1];
                }
                else{
                    dp[i][j] = Math.max(dp[i-1][j] , dp[i][j-1]);
                }
            }
        }


        return dp[n][n];
    }
}

T.C. -> O(n^2)
S.C. -> O(n^2) (DP Table Array) , Extra Variables: $O(n)$

