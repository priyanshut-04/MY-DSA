class Solution {
    int[][] t;
    private int solve(int i , int j , String s , String r){
        if(i == s.length() || j == r.length()){
            return 0;
        }

        if(t[i][j] != -1) return t[i][j];

        if(s.charAt(i) == r.charAt(j)){
            return t[i][j] = 1 + solve(i+1 , j+1 , s , r);
        }

        int take_s = solve(i+1 , j , s , r);
        int take_r = solve(i , j+1 , s, r);

        return t[i][j] = Math.max(take_s , take_r); 
    }
    public int longestPalindromeSubseq(String s) {
        String rev = "";
        for(int i = s.length()-1; i>=0; i--){
            rev += s.charAt(i);
        }
        int n = s.length();

        t = new int[n][n];
        for(int i = 0; i<n; i++){
            Arrays.fill(t[i] , -1);
        }

        return solve(0 , 0 , s , rev);
    }
}

T.C. -> O(n^2)
S.C. -> O(n^2) (Memoization Array) , Stack Memory (Recursion): $O(n)$ , Extra Variables: $O(n)$

