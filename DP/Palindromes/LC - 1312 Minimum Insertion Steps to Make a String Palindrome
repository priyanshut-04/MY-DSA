class Solution {
    public int minInsertions(String s) {
        int n = s.length();

        int[][] dp = new int[n][n];

        for(int L = 1; L<=n; L++){
            for(int i = 0; i+L-1<n; i++){
                int j = i+L-1;

                if(i == j) continue;

                else if(s.charAt(i) == s.charAt(j)){
                    dp[i][j] = dp[i+1][j-1];
                }
                else{
                    dp[i][j] = 1 + Math.min(dp[i+1][j] , dp[i][j-1]);
                }
            }
        }

        return dp[0][n-1];
    }
}

T.C. -> O(n^2)
S.C. -> O(n^2) (DP Table Array)

